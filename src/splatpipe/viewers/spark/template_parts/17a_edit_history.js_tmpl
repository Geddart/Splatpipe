  // ============================================================
  //  EditHistory (Phase 2 -- editor-arc-design #122, R8 snapshot)
  // ------------------------------------------------------------
  //  Ring-buffer undo/redo for the editor session. Snapshot pattern
  //  (R8 §3, conflict-1 resolution): each gesture pushes ONE
  //  JSON-cloned snapshot of `cfg`; undo pops the stack and restores
  //  the whole cfg in-place (Object.keys(cfg).forEach + Object.assign
  //  semantics so existing references remain valid). Redo re-applies
  //  by walking forward in the ring.
  //
  //  WHY SNAPSHOT (not command pattern):
  //    typical cfg ~ 8 KB JSON; worst plausible ~ 50 KB JSON, ~200 KB
  //    in-heap. 200 snapshots = ~40 MB max -- a rounding error vs the
  //    100-674 MB GPU splat data already in memory. Snapshot saves ~50
  //    per-module inverse-op routines (a real dev + test surface cost)
  //    and every undo is one line. See spec §6.2 + §10.1 for the full
  //    trade-off rationale.
  //
  //  GRANULAR-VS-COARSE rule (CRITICAL per R8 §4.2): each *gesture*
  //  pushes ONE snapshot at gesture start -- NEVER per animation
  //  frame. The standard call sites the modules must use are:
  //
  //    Gizmo TransformControls dragging-changed=true (drag-start)
  //      => EditorModuleRegistry.pushUndo('kf-drag')   (before mutation)
  //    Recorder K press
  //      => pushUndo('kf-record')                       (before append)
  //    Timeline kf-drag pointerdown on a diamond
  //      => pushUndo('kf-timeline-drag')                (before mutation)
  //    Timeline scale-edge pointerdown
  //      => pushUndo('kf-scale')                        (before mutation)
  //    Interp popover button click
  //      => pushUndo('kf-interp')                       (before mutation)
  //    Camera rename input FOCUS (NOT per keystroke)
  //      => pushUndo('cam-rename')                      (before commit)
  //    Total-time input commit (Enter/blur, NOT per keystroke)
  //      => pushUndo('path-total-time')                 (before commit)
  //    Auto-toggle button click
  //      => pushUndo('path-auto-toggle')                (before mutation)
  //
  //  Drag-END / value-change-FINALISED does NOT push -- the snapshot at
  //  drag-start IS the undo entry. WRONG pattern (per spec §6.3):
  //  pushing on mousemove -- yields 60 entries/s + an unusable history.
  //
  //  EPHEMERAL (R8 §5): history clears on
  //    - mode switch (author -> enduser etc.)
  //    - save (the saved cfg is the new clean baseline)
  //    - scene reload
  //  NOT persisted to localStorage.
  //
  //  TEST SURFACE: window.__sceneview.history exposes the IIFE.
  //  Tests assert push/undo/redo/canUndo/canRedo/clear/cap.
  // ============================================================
  const EditHistory = (() => {
    // R8 cap: 200 entries * ~200 KB worst-case = ~40 MB heap ceiling.
    const _HISTORY_CAP = 200;
    // Stack of snapshots. CONVENTION (WF-H2 fix, #143): every gesture
    // pushes ONE snapshot of the PRE-gesture cfg BEFORE mutating (NO
    // init-time baseline is ever pushed -- every module's pushUndo fires
    // before its own mutation; see the call-site list above). So after
    // N edits the stack holds N pre-state snapshots [S0..S(N-1)] and the
    // CURRENT live cfg (= S(N)) is NOT yet in the stack.
    //
    //   _cursor == _stack.length  => the current live cfg is NOT in the
    //       stack; _stack[_cursor-1] is the immediately-prior state. This
    //       is the state right after every push (and at boot, cursor=0).
    //   _cursor <  _stack.length  => we are sitting on a snapshot (after
    //       an undo/redo); _stack[_cursor] == the current live cfg.
    //
    // The current state has no snapshot during pushing, so the FIRST undo
    // materialises it (clones the present onto the top of the stack) so a
    // later redo has a state to return to -- the "lazy redo head" pattern.
    // After that one capture, undo/redo are a symmetric cursor walk:
    //   canUndo => _cursor > 0            (a prior snapshot exists)
    //   canRedo => _cursor < length - 1   (a later snapshot exists)
    //   undo    => [capture present if at head] _cursor-=1; restore _stack[_cursor]
    //   redo    => _cursor+=1; restore _stack[_cursor]
    // This makes the FIRST user edit undoable (cursor 1 -> 0) and every
    // undo step back exactly ONE gesture (no skipping) -- the WF-H2 bug
    // was canUndo=`_cursor>1` (first edit not undoable) + undo restoring
    // _stack[_cursor-2] (skipping the intermediate state).
    const _stack = [];
    let _cursor = 0;

    function _warn(msg) {
      try { console.warn('[EditHistory] ' + msg); } catch (e) {}
    }

    // Resolve the live cfg object. cfg is the module-scope const set
    // in 06_cfg.js_tmpl; we resolve dynamically so tests can shim
    // window.cfg or run the fragment in isolation. In the real viewer
    // there's only one cfg and the resolution returns the SAME object
    // every call.
    function _liveCfg() {
      try {
        if (typeof cfg !== 'undefined' && cfg) return cfg;
      } catch (e) {}
      try {
        if (typeof window !== 'undefined' && window.cfg) return window.cfg;
      } catch (e) {}
      return null;
    }

    function _clone(obj) {
      // JSON-clone (the standard structuredClone polyfill that works
      // back to every browser the viewer targets). cfg is plain JSON
      // (no functions, no DOM refs, no circular -- a sanitised public
      // viewer-config) so JSON.stringify round-trip is lossless.
      try { return JSON.parse(JSON.stringify(obj)); }
      catch (e) { _warn('clone failed: ' + e); return null; }
    }

    // UX-Phase11A Issue 3 (2026-05-21): keys whose VALUE is an array that
    // a fragment captured BY REFERENCE at init time. The proven case is
    // `const cameraPaths = cfg.camera_paths || []` in 09_playback_spline
    // (read by _camSelCameras / startPath / buildPlayer / the dropdown
    // UNION). A plain Object.assign would set cfg.camera_paths = <cloned
    // new array>, leaving that local alias pointing at the STALE old
    // array -> the camera dropdown loses / duplicates entries after an
    // undo/redo ("sometimes the Fehmarn cam is missing all of a
    // sudden"). For these keys we mutate the EXISTING array IN PLACE
    // (length=0 + push the clone's elements) so every captured alias
    // stays valid. Scoped DELIBERATELY to camera_paths only: cfg.cameras
    // / cfg.audio / cfg.annotations / cfg.clips / cfg.titles3d are each
    // read LIVE (`cfg.<key>` fresh per access) by their owner module, so
    // there is no captured-at-init alias to preserve for them -- and a
    // restore that DROPS such a key must DELETE it (a stale empty []
    // would be wrong; see test_edit_history::
    // test_restore_clears_keys_added_after_snapshot which asserts a
    // post-snapshot key is deleted on restore). Only camera_paths has
    // the load-bearing const alias, so only it gets in-place treatment.
    const _RESTORE_INPLACE_ARRAY_KEYS = [
      'camera_paths',
    ];
    function _restoreArrayInPlace(targetArr, sourceArr) {
      // Deep-replace targetArr's CONTENTS with sourceArr's (which is a
      // JSON-clone, so we can take its elements directly). targetArr is
      // the live array every alias points at; we keep its identity.
      targetArr.length = 0;
      if (Array.isArray(sourceArr)) {
        for (let i = 0; i < sourceArr.length; i++) targetArr.push(sourceArr[i]);
      }
    }
    function _restore(target, source) {
      // Restore by clearing target's keys then Object.assign-ing source.
      // Why: callers (modules, getters) hold a REFERENCE to the live cfg
      // object; we MUST NOT swap it out -- only mutate its contents.
      if (!target || !source) return;
      const tkeys = Object.keys(target);
      for (const k of tkeys) {
        if (!Object.prototype.hasOwnProperty.call(source, k)) {
          // UX-Phase11A Issue 3: for an aliased array key, EMPTY it in
          // place rather than delete (so the alias survives a restore
          // that drops the key entirely -- the alias just becomes []).
          if (_RESTORE_INPLACE_ARRAY_KEYS.indexOf(k) !== -1 &&
              Array.isArray(target[k])) {
            target[k].length = 0;
          } else {
            try { delete target[k]; } catch (e) {}
          }
        }
      }
      // UX-Phase11A Issue 3: for each aliased array key present in BOTH,
      // mutate the existing target array IN PLACE so cross-fragment
      // aliases (cameraPaths const etc.) keep pointing at the live data.
      for (const k of _RESTORE_INPLACE_ARRAY_KEYS) {
        if (Object.prototype.hasOwnProperty.call(source, k) &&
            Array.isArray(target[k]) && Array.isArray(source[k])) {
          _restoreArrayInPlace(target[k], source[k]);
        }
      }
      // Everything else (scalars, objects, + any array key NOT aliased /
      // NOT already an array on target) goes through the normal
      // reference-set. The aliased-array keys handled above are
      // re-assigned here too, but only when target[k] was NOT already a
      // live array (e.g. it was absent or a non-array) -- in that case
      // there is no alias to preserve, so a reference-set is correct.
      const skip = Object.create(null);
      for (const k of _RESTORE_INPLACE_ARRAY_KEYS) {
        if (Array.isArray(target[k])) skip[k] = true;
      }
      for (const k of Object.keys(source)) {
        if (skip[k]) continue;
        target[k] = source[k];
      }
    }

    function push(label) {
      const live = _liveCfg();
      if (!live) return false;
      const snap = _clone(live);
      if (snap == null) return false;
      // Truncate any "future" entries (the redo tail) -- a fresh push
      // after an undo invalidates the redo path.
      if (_cursor < _stack.length) {
        _stack.length = _cursor;
      }
      _stack.push({ label: label || '', snap: snap, t: Date.now() });
      _cursor = _stack.length;
      // Cap: drop oldest if over (ring eviction, warn on overflow per
      // spec instruction).
      if (_stack.length > _HISTORY_CAP) {
        const drop = _stack.length - _HISTORY_CAP;
        _stack.splice(0, drop);
        _cursor = _stack.length;
        _warn('overflow: evicted ' + drop +
          ' oldest snapshot(s); cap=' + _HISTORY_CAP);
      }
      try {
        if (typeof EditorModuleRegistry !== 'undefined' &&
            typeof EditorModuleRegistry.emit === 'function') {
          EditorModuleRegistry.emit('history:push', label || '');
        }
      } catch (e) {}
      return true;
    }

    // canUndo: a prior pre-gesture snapshot exists to roll back to. The
    // FIRST edit (cursor=1 after its single push) IS undoable -> `> 0`.
    function canUndo() { return _cursor > 0; }
    // canRedo: a later snapshot exists beyond the current position. Only
    // possible after an undo materialised the redo head, so the live cfg
    // sits at _stack[_cursor] with at least one snapshot above it.
    function canRedo() { return _cursor < _stack.length - 1; }

    function undo() {
      if (!canUndo()) return null;
      // Lazy redo head: the current live cfg is only in the stack once an
      // undo materialises it. If we are at the head (_cursor == length),
      // clone the present onto the top so a later redo can return to it.
      if (_cursor === _stack.length) {
        const present = _clone(_liveCfg());
        if (present != null) {
          _stack.push({ label: '(current)', snap: present, t: Date.now() });
          // Respect the ring cap even for the materialised head: evict the
          // oldest and shift the cursor down so it still points at the same
          // logical snapshot (front eviction renumbers every index).
          if (_stack.length > _HISTORY_CAP) {
            const drop = _stack.length - _HISTORY_CAP;
            _stack.splice(0, drop);
            _cursor = Math.max(0, _cursor - drop);
            _warn('overflow: evicted ' + drop +
              ' oldest snapshot(s); cap=' + _HISTORY_CAP);
          }
        }
      }
      // Step back exactly one gesture and restore the snapshot now at the
      // new cursor (the pre-state of the gesture we just undid).
      _cursor -= 1;
      const entry = _stack[_cursor];
      const live = _liveCfg();
      if (entry && live) {
        _restore(live, entry.snap);
        _broadcastCfgChange(entry.label || '', 'undo');
      }
      try {
        if (typeof EditorModuleRegistry !== 'undefined' &&
            typeof EditorModuleRegistry.emit === 'function') {
          EditorModuleRegistry.emit('history:undo', entry ? entry.label : '');
        }
      } catch (e) {}
      return entry;
    }

    function redo() {
      if (!canRedo()) return null;
      // Step forward exactly one gesture and restore the snapshot now at
      // the new cursor (the state that gesture produced).
      _cursor += 1;
      const entry = _stack[_cursor];
      const live = _liveCfg();
      if (entry && live) {
        _restore(live, entry.snap);
        _broadcastCfgChange(entry.label || '', 'redo');
      }
      try {
        if (typeof EditorModuleRegistry !== 'undefined' &&
            typeof EditorModuleRegistry.emit === 'function') {
          EditorModuleRegistry.emit('history:redo', entry ? entry.label : '');
        }
      } catch (e) {}
      return entry;
    }

    function clear() {
      _stack.length = 0;
      _cursor = 0;
    }

    function _broadcastCfgChange(label, dir) {
      // UX-Phase11F H5 (2026-05-21): an undo/redo restore mutates
      // cfg.camera_paths IN PLACE (Phase 11A Issue 3) -- the array
      // identity survives but the keyframe OBJECTS inside it are
      // REPLACED (the restore _restoreArrayInPlace pushes the clone's
      // elements, so p.keyframes[i] is a NEW object). The keyframe
      // gizmo (17_editor_gizmo TransformControls) stays bound to its
      // proxy parked at the OLD selected-keyframe's pose; after the
      // restore that proxy no longer corresponds to any live keyframe
      // (its index may now point at a different kf, or out of range)
      // so a subsequent gizmo drag writes to a STALE proxy. Drop any
      // active gizmo selection on EVERY undo/redo so the author must
      // re-pick a keyframe against the restored geometry. gzDetach is
      // exposed by 17_editor_gizmo (which runs AFTER this fragment but
      // is fully wired by the time a user-driven undo/redo fires);
      // typeof-guarded so it is inert before the gizmo surface exists /
      // on a non-author boot.
      try {
        if (window.__editor &&
            typeof window.__editor.gzDetach === 'function') {
          window.__editor.gzDetach();
        }
      } catch (e) {}
      // Notify every module that cfg changed wholesale (the safe
      // signal: stateKey = '*'). Modules that care can re-read cfg
      // and refresh their UI / overlays.
      try {
        if (typeof EditorModuleRegistry !== 'undefined' &&
            typeof EditorModuleRegistry.notifyCfgChange === 'function') {
          EditorModuleRegistry.notifyCfgChange('*', null, _liveCfg());
        }
      } catch (e) {}
    }

    return {
      push: push,
      undo: undo,
      redo: redo,
      canUndo: canUndo,
      canRedo: canRedo,
      clear: clear,
      get length() { return _stack.length; },
      get cursor() { return _cursor; },
      get capacity() { return _HISTORY_CAP; },
      // Test surface: read-only snapshot list (label + time only;
      // never the snap bytes themselves -- those are large).
      labels: function () {
        return _stack.map(function (e) {
          return { label: e.label, t: e.t };
        });
      },
    };
  })();

  // Publish onto window.__sceneview.history. 05_framework runs BEFORE
  // this fragment and creates window.__sceneview; if not present (a
  // dev harness loading fragments out of order) fall back to creating
  // a stub so EditorModuleRegistry's history-getter still works.
  try {
    if (typeof window !== 'undefined') {
      window.__sceneview = window.__sceneview || {};
      window.__sceneview.history = EditHistory;
    }
  } catch (e) {}

  // ---- Hotkeys: Ctrl+Z / Ctrl+Y / Ctrl+Shift+Z (Cmd+ on macOS).
  //      Wired centrally on window keydown so any focused element
  //      that isn't a text input gets the shortcut. Gated on author
  //      mode -- end-user / embed never see undo.
  window.addEventListener('keydown', function (ev) {
    try {
      if (!ModeManager.is('author')) return;
    } catch (e) { return; }
    // Don't hijack when typing into a real text-entry field (the browser's
    // native text undo must win there). UX-Phase11G WF-H3 (#144): use the
    // NARROWER _editorUndoHotkeyBlocked() guard (04_js_prologue) -- NOT the
    // broad _editorHotkeyBlocked() the destructive single-key hotkeys use.
    // The broad guard blocks ALL hotkeys inside a [role=dialog], but the
    // Scene Settings drawer IS a [role=dialog], so it killed Ctrl+Z while
    // editing there. Undo/redo is safe inside a dialog/menu (it only
    // restores cfg) -- it must merely defer to a focused TEXT input /
    // textarea / contenteditable. H6 stays intact: the destructive T/R/X/K/
    // V/B hotkeys still route through the broad guard, so K/X never fire
    // behind the kebab menu or a dialog.
    if (_editorUndoHotkeyBlocked()) return;
    const mod = ev.metaKey || ev.ctrlKey;
    if (!mod) return;
    const k = (ev.key || '').toLowerCase();
    if (k === 'z' && !ev.shiftKey) {
      ev.preventDefault();
      EditorModuleRegistry.undo();
    } else if (k === 'y' || (k === 'z' && ev.shiftKey)) {
      ev.preventDefault();
      EditorModuleRegistry.redo();
    }
  });

