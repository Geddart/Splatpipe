  // ============================================================
  //  Author editor -- bottom timeline (Task 17 -- plan H2/Task-13)
  // ------------------------------------------------------------
  //  AUTHOR MODE ONLY (ModeManager.is('author')): user / embed and
  //  the 6 live single-camera scenes are byte-runtime-unchanged --
  //  every code path here is gated by the SAME _EDITOR_AUTHOR flag
  //  the Task-16 trajectory overlay uses, and the strip DOM is only
  //  ever built in author mode (so this whole section is inert in
  //  user/embed; the byte-lock proves the 6 live scenes' generated
  //  HTML is byte-identical -- this code sits strictly INSIDE the
  //  Task-16 T16-TRAJ region, recipe 2c, so it is absorbed by that
  //  region's existing excision and the moving-baseline remainder
  //  is unaffected by it).
  //  IN-MEMORY temporal edits ONLY (the Task-17 scope boundary):
  //    * a SECONDS ruler (the storage unit is ALWAYS seconds); an
  //      OPTIONAL author fps grid that ONLY relabels the ruler
  //      ticks (fps is a display relabel -- it NEVER mutates a
  //      stored kf.t).
  //    * a diamond per keyframe at its kf.t; dragging it
  //      horizontally edits THAT keyframe's t (a temporal edit) --
  //      mutates the in-memory active path (_trajActivePath(), the
  //      SAME object the live player + the Task-16 overlay read)
  //      and rebuilds the spline. The Task-16 overlay's
  //      sig-driven OverlayScene.update() rebuild reacts to the
  //      kf.t change automatically (its _trajKfSig includes
  //      (k.t||0)); we ALSO null _player so the live player picks
  //      up the new geometry on its next grab.
  //    * a live-scrub playhead: dragging it drives the camera LIVE
  //      via the EXISTING #path-scrub real 'input' mechanism (the
  //      single source of truth that takes `_player` over for the
  //      selected path AND rebases `_t0`) -- NOT only during play,
  //      and ROBUST to the author-mode default-path auto-tour
  //      (which auto-plays here because _cinematic is usermode-
  //      only): the real scrub takes the camera over deterministic-
  //      ally exactly as a user grabbing the slider would. We do
  //      NOT reimplement the scrub math (lockstep with the player).
  //    * transport play / pause / loop (reuse the existing
  //      #path-play / #path-stop handlers; loop toggles the active
  //      path's loop flag + rebuilds).
  //    * wheel zoom (time scale) about the cursor time; pan via
  //      scroll. Zoom/scroll change ONLY the px mapping, never a
  //      stored t.
  //    * box-select 2+ diamonds, then drag a SELECTION EDGE handle
  //      => proportionally rescale the selected keyframes' t span
  //      about the OPPOSITE edge anchor (ratio = newSpan/oldSpan;
  //      t' = anchor + (t-anchor)*ratio). X deletes the selected
  //      keyframes. Both mutate the in-memory path + rebuild.
  //  PERSISTENCE IS NOT TASK-17: nothing here writes/saves; edits
  //  mutate the in-memory active path + rebuild the spline (+ the
  //  Task-16 overlay consequently) and stop there. SAVE_MODE /
  //  SAVE_ENDPOINT / save_backends are deliberately untouched (a
  //  later task owns Record + Emit SPCP).
  //  Reuses, never reinvents: buildPlayer / sampleAt (the
  //  SuperSplat cubic-Hermite spline), the #path-scrub real input
  //  mechanism (camera takeover / _t0 rebase), _trajActivePath()
  //  (the in-memory active path), the Task-16 sig-driven overlay
  //  rebuild, the #author-root inline-style pattern, ModeManager.
  //  window.__editor is EXTENDED (TEST-ONLY: getters + deterministic
  //  hooks, same convention as window.__clip / __transport; no
  //  production reader; inert without the harness).
  // ============================================================
  (function _tlInit() {
    if (!_EDITOR_AUTHOR) return;
    const root = document.getElementById('author-root');
    if (!root) return;

    // ---- View state (px mapping). Storage is ALWAYS seconds; zoom
    //      (px per second) + scroll (seconds of left-edge offset)
    //      are PURE DISPLAY -- they never touch a stored kf.t.
    const _TL_PAD = 8;             // left inset (px) inside the lane
    // A3/A4: a DEDICATED transport-bar band at the strip top so the
    // play/pause/loop/fps (+ the A4-merged Rec/interp/tangents/Save)
    // buttons sit ABOVE the lane and never overlap the seconds ruler
    // (the old top:6px _tlBar overlapped the ruler band drawn at
    // canvas-y 0.._TL_RULER_H). The lane is offset down by _TL_BAR_H
    // (was a hard-coded 24) and the strip grew to keep the same lane
    // height for the ruler/diamonds/playhead.
    const _TL_BAR_H = 30;          // transport-bar band height (px)
    // Base strip height (transport bar + ruler + diamond row) BEFORE
    // any module lane bands. The strip GROWS by sum(lane.rows) *
    // _TL_LANE_ROW_H once modules register their timeline lanes
    // (UX-Phase11-R2 #11). _TL_H is the live (current) strip height,
    // recomputed by _tlSyncHeight() whenever the lane set changes.
    const _TL_H_BASE = 64 + (_TL_BAR_H - 24); // base strip height (px)
    const _TL_LANE_ROW_H = 22;     // per-lane-ROW band height (px)
    let _TL_H = _TL_H_BASE;        // live strip height (px)
    const _TL_RULER_H = 16;        // seconds-ruler band height (px)
    let _tlZoom = 80;              // px / second (wheel-tunable)
    let _tlScroll = 0;             // seconds at the lane's left edge
    const _TL_ZOOM_MIN = 2, _TL_ZOOM_MAX = 4000;
    let _tlFps = 0;                // 0 = OFF (seconds labels); >0 = fps grid
    let _tlSel = new Set();        // selected keyframe indices
    let _tlDragKf = -1;            // keyframe index being time-dragged
    let _tlDragMode = '';          // '' | 'kf' | 'play' | 'scale' | 'box'
    let _tlScaleEdge = '';         // 'left' | 'right' (which edge is grabbed)
    let _tlScaleAnchor = 0;        // the FIXED opposite-edge time (seconds)
    let _tlScaleBase = null;       // [{i, t0}] selected kf base times at grab
    let _tlBoxX0 = 0;              // marquee start x (lane px)
    let _tlBoxX1 = 0;
    let _tlScrubbing = false;      // playhead being live-dragged

    function _tlActivePath() {
      // The SAME in-memory object the live player + the Task-16
      // overlay use (reuse, never a parallel copy).
      return (typeof _trajActivePath === 'function')
        ? _trajActivePath() : null;
    }
    function _tlSortedKfs(p) {
      if (!p || !p.keyframes) return [];
      // A stable index-tagged sort by t so a diamond keeps its
      // identity (the kf OBJECT) across a temporal edit even when
      // the order changes.
      return p.keyframes
        .map((k, i) => ({ k: k, i: i, t: (k.t || 0) }))
        .sort((a, b) => a.t - b.t);
    }
    function _tlDuration(p) {
      const sk = _tlSortedKfs(p);
      if (sk.length < 2) return sk.length ? (sk[0].t || 0) : 0;
      // Includes hold_s (mirrors buildPlayer's accumulated duration
      // so the playhead<->scrub mapping is consistent with the
      // player clock).
      let acc = 0;
      for (const e of sk) acc += (e.k.hold_s && e.k.hold_s > 0)
        ? e.k.hold_s : 0;
      const kfDur = (sk[sk.length - 1].t || 0) + acc;
      // UX-Phase11A Issue 6 (2026-05-21): honour total_duration_s when
      // it extends past the kf-derived range -- mirrors the same lift
      // in buildPlayer (09_playback_spline) so the timeline scrub
      // ruler / playhead<->scrub mapping align with the player's
      // duration. Without this the timeline canvas would stop drawing
      // at the last kf even though the player + scrub can reach the
      // extended range, leaving a "phantom" scrub past the visible
      // ruler. Mirrors _effectiveScrubRange() below.
      if (p && typeof p.total_duration_s === 'number' &&
          isFinite(p.total_duration_s) && p.total_duration_s > kfDur) {
        return p.total_duration_s;
      }
      return kfDur;
    }
    // time (seconds) -> x within the lane (px); inverse for hit-test
    // / drag. Pure display math (zoom/scroll) -- never a stored t.
    function _tlT2X(t) { return _TL_PAD + (t - _tlScroll) * _tlZoom; }
    function _tlX2T(x) { return _tlScroll + (x - _TL_PAD) / _tlZoom; }

    // ---- DOM: a bottom strip injected into #author-root, inline-
    //      styled exactly like #sp-hud / the Task-16 toggle (no new
    //      CSS region). Pointer-events on the strip only; the strip
    //      never covers the whole canvas.
    const _tlStrip = document.createElement('div');
    _tlStrip.id = 'editor-timeline';
    _tlStrip.style.cssText =
      'position:absolute;left:0;right:0;bottom:0;height:' + _TL_H +
      'px;z-index:48;box-sizing:border-box;' +
      'background:rgba(16,16,16,0.82);' +
      '-webkit-backdrop-filter:blur(6px);backdrop-filter:blur(6px);' +
      'border-top:1px solid rgba(255,255,255,0.12);' +
      'font:11px -apple-system,BlinkMacSystemFont,Segoe UI,sans-serif;' +
      'color:#ccc;user-select:none;touch-action:none;overflow:hidden;';

    // Transport cluster (left): play / pause / loop / fps. Reuses
    // the existing #path-play / #path-stop handlers (no new stop /
    // play mechanism). A3: lives in the dedicated top band
    // (strip-y 0.._TL_BAR_H), vertically centred, clear of the ruler.
    // A4: the merged Rec/interp/tangents/Save bar is appended onto
    // this SAME row by _gzInit via the shared _tlBarRow ref below.
    const _tlBar = document.createElement('div');
    _tlBar.style.cssText =
      'position:absolute;left:8px;right:8px;top:0;height:' + _TL_BAR_H +
      'px;display:flex;gap:6px;align-items:center;z-index:2;';
    function _tlBtn(txt, title) {
      const b = document.createElement('button');
      b.type = 'button'; b.textContent = txt; b.title = title || '';
      b.style.cssText =
        'background:rgba(255,255,255,0.10);color:#eee;border:0;' +
        'border-radius:5px;padding:4px 9px;cursor:pointer;' +
        'font:12px monospace;line-height:1;';
      return b;
    }
    // UX-Phase11-R2 #3 (2026-05-21): thin vertical divider to visually
    // SEPARATE the undo/redo history group from the Play/Loop transport
    // controls in the same flex row (R2 #3: the buttons were "awkwardly
    // positioned" -- wedged glyph-only between Play and Loop with no
    // grouping cue). Pure inline-styled span, no new CSS region.
    function _tlDivider() {
      const d = document.createElement('span');
      d.setAttribute('aria-hidden', 'true');
      d.style.cssText =
        'flex:0 0 auto;width:1px;height:18px;margin:0 3px;' +
        'background:rgba(255,255,255,0.18);';
      return d;
    }
    // UX-Phase11A Issue 5 (2026-05-21): unified Play/Pause toggle. The
    // separate Pause button is REMOVED; _tlPlay is now a tri-state
    // toggle (idle \u25B6 -> playing \u23F8 -> paused \u25B6 -> resume \u23F8 ...). The
    // glyph + title are synced by _tlSyncPlayPauseIcon() off the
    // window.__spTransport.playState() the 10_camera_select fragment
    // exposes. User-requested: "get rid of the pause button and have
    // the play button do that ... push it twice, it becomes a pause
    // icon ... click it again, it becomes a play icon and it plays."
    const _tlPlay = _tlBtn('\u25B6', 'Play / Pause');
    const _tlLoop = _tlBtn('\u21BB', 'Loop');
    const _tlFpsBtn = _tlBtn('fps', 'Toggle fps grid (relabels ruler only)');
    // UX-Phase11G WF-H3 (#144): VISIBLE Undo / Redo affordance. The editor
    // had Ctrl+Z/Y wired (17a) but NO clickable button, so a user who never
    // tried the hotkey could not undo at all (the WF-H3 "undo is dead in the
    // drawer + no button" report). The transport row is the always-reachable
    // author surface (it is built unconditionally in author mode + never
    // hidden behind the closed Scene Settings drawer), so the buttons live
    // here next to Play. They delegate to EditorModuleRegistry.undo/redo (the
    // ONE coordinator) and their disabled state follows canUndo()/canRedo()
    // -- synced every frame by _tlSyncUndoRedo() off _tlSyncPlayhead (same
    // per-frame path the Play glyph uses) so a programmatic edit / hotkey
    // undo keeps the buttons accurate without a manual refresh.
    // R2 #3 (2026-05-21): clearer undo/redo affordance. The buttons were
    // 28px glyph-only and easy to miss; give them a LARGER hit target
    // (more padding + bigger glyph), a short text label so they read as
    // "undo"/"redo" (not just an ambiguous arrow), and group them between
    // dividers so they sit visually apart from Play/Loop. They stay in the
    // transport row (the always-reachable author surface) and keep the
    // per-frame _tlSyncUndoRedo() enable/disable sync.
    const _tlUndo = _tlBtn('\u21B6 undo', 'Undo (Ctrl+Z)');
    const _tlRedo = _tlBtn('redo \u21B7', 'Redo (Ctrl+Y)');
    const _UNDO_BTN_CSS =
      'background:rgba(255,255,255,0.10);color:#eee;border:0;' +
      'border-radius:5px;padding:5px 10px;cursor:pointer;' +
      'font:12px monospace;line-height:1;letter-spacing:0.2px;' +
      'display:inline-flex;align-items:center;gap:4px;';
    _tlUndo.style.cssText = _UNDO_BTN_CSS;
    _tlRedo.style.cssText = _UNDO_BTN_CSS;
    _tlBar.appendChild(_tlPlay);
    _tlBar.appendChild(_tlDivider());
    _tlBar.appendChild(_tlUndo); _tlBar.appendChild(_tlRedo);
    _tlBar.appendChild(_tlDivider());
    _tlBar.appendChild(_tlLoop); _tlBar.appendChild(_tlFpsBtn);

    // ---- Phase 2C (#122 \u00A74.1.1): Prev/Next-keyframe skip + a single
    //      always-editable LENGTH field. Prev/Next consult the
    //      SORTED-by-t kf view as the source of truth (the editor
    //      permits dragging a diamond past its neighbours, so raw
    //      array order is NOT chronological).
    //  UX-Phase11-R2 #5 (2026-05-21): the prior auto/manual toggle is
    //      REMOVED. User: "I don't even know what auto/manual means.
    //      It should just be length, nothing else." The field is now
    //      ALWAYS editable + labelled "Length [N] s". It pre-fills
    //      with `_effectiveScrubRange(p)[1]` (which is the kf-derived
    //      ceiling -- max(last kf.t, 10) -- while total_duration_s is
    //      null); the moment the user edits it, `total_duration_s` is
    //      set to the typed value and sticks. Python
    //      effective_scrub_range is UNCHANGED (positive
    //      total_duration_s wins, null = derive); we simply stop ever
    //      writing null from the UI.
    const _tlPrevKf = _tlBtn('\u25C0\uFE0F|', 'Prev keyframe (Ctrl+Left)');
    const _tlNextKf = _tlBtn('|\u25B6\uFE0F', 'Next keyframe (Ctrl+Right)');
    // Length caption -- a small label so the field reads as "Length".
    const _tlTotalLabel = document.createElement('span');
    _tlTotalLabel.textContent = 'Length';
    _tlTotalLabel.style.cssText = 'color:#9aa;font:11px monospace;';
    // Length input -- numeric, narrow; ALWAYS editable. Always reflects
    // the current scrub-range ceiling (`effectiveScrubRange[1]`) until
    // the user types a value, after which it shows total_duration_s.
    const _tlTotalInput = document.createElement('input');
    _tlTotalInput.type = 'number';
    _tlTotalInput.min = '0';
    _tlTotalInput.step = '0.1';
    _tlTotalInput.style.cssText =
      'background:rgba(255,255,255,0.10);color:#eee;border:0;' +
      'border-radius:5px;padding:3px 6px;font:12px monospace;' +
      'line-height:1;width:56px;';
    _tlTotalInput.title = 'Path length (seconds)';
    const _tlTotalUnit = document.createElement('span');
    _tlTotalUnit.textContent = 's';
    _tlTotalUnit.style.cssText = 'color:#9aa;font:11px monospace;';
    _tlBar.appendChild(_tlPrevKf);
    _tlBar.appendChild(_tlNextKf);
    _tlBar.appendChild(_tlTotalLabel);
    _tlBar.appendChild(_tlTotalInput);
    _tlBar.appendChild(_tlTotalUnit);

    _tlStrip.appendChild(_tlBar);
    // A4: publish the transport row so _gzInit (runs AFTER this IIFE)
    // can merge the Rec/interp/tangents/Save cluster onto it instead
    // of a separate floating #editor-gizmo-bar.
    _tlBarRow = _tlBar;

    // The lane (ruler + diamonds + playhead). A canvas draws the
    // ruler + diamonds + selection box; a thin div is the playhead.
    // A3: starts BELOW the transport band (_TL_BAR_H) so the ruler
    // (canvas-y 0.._TL_RULER_H) never sits under the buttons.
    const _tlLane = document.createElement('div');
    _tlLane.style.cssText =
      'position:absolute;left:0;right:0;bottom:0;height:' +
      (_TL_H - _TL_BAR_H) + 'px;cursor:crosshair;';
    const _tlCanvas = document.createElement('canvas');
    _tlCanvas.style.cssText =
      'position:absolute;inset:0;width:100%;height:100%;display:block;';
    const _tlPlayhead = document.createElement('div');
    _tlPlayhead.style.cssText =
      'position:absolute;top:0;bottom:0;width:2px;left:0;' +
      'background:#35e0ff;box-shadow:0 0 4px #35e0ff;' +
      'pointer-events:none;will-change:left;';
    _tlLane.appendChild(_tlCanvas);
    _tlLane.appendChild(_tlPlayhead);
    _tlStrip.appendChild(_tlLane);
    root.appendChild(_tlStrip);

    const _tlCtx = _tlCanvas.getContext('2d');
    let _tlW = 0, _tlHpx = 0, _tlDpr = 1;
    // UX-Phase11-R2 #11: total ROWS contributed by every registered
    // module lane (each lane advertises a `rows` count). The strip
    // grows by this * _TL_LANE_ROW_H so the lane bands are visible
    // below the diamond row. TDZ-safe: _tlLaneList() reads the lane
    // consts which are initialised later in this IIFE, but this is only
    // ever CALLED at runtime (from _tlResize via rAF / on register),
    // by which point they exist.
    function _tlTotalLaneRows() {
      let rows = 0;
      try {
        const lanes = _tlLaneList();
        for (const e of lanes) {
          const r = e && e.lane && (e.lane.rows | 0);
          rows += (r && r > 0) ? r : 1;
        }
      } catch (e) {}
      return rows;
    }
    // Recompute the live strip height from the base + lane rows and
    // push it onto the strip + lane inline heights (they were created
    // with the base height baked into cssText). The lane fills the
    // strip below the transport bar.
    function _tlSyncHeight() {
      _TL_H = _TL_H_BASE + _tlTotalLaneRows() * _TL_LANE_ROW_H;
      _tlStrip.style.height = _TL_H + 'px';
      _tlLane.style.height = (_TL_H - _TL_BAR_H) + 'px';
    }
    function _tlResize() {
      _tlSyncHeight();
      const r = _tlLane.getBoundingClientRect();
      _tlDpr = Math.max(1, window.devicePixelRatio || 1);
      _tlW = Math.max(1, Math.floor(r.width));
      _tlHpx = Math.max(1, Math.floor(r.height));
      _tlCanvas.width = Math.floor(_tlW * _tlDpr);
      _tlCanvas.height = Math.floor(_tlHpx * _tlDpr);
      _tlDraw();
    }

    // ---- Diamond geometry (canvas-space hit test). Each keyframe
    //      is a diamond centred at (_tlT2X(kf.t), diamond-row-y).
    const _TL_DIAM = 7;            // half-size (px)
    function _tlDiamRowY() { return _TL_RULER_H + 14; }
    function _tlHitKf(x, y) {
      // Topmost keyframe whose diamond contains (x,y); -1 = none.
      const p = _tlActivePath();
      if (!p || !p.keyframes) return -1;
      const cy = _tlDiamRowY();
      let best = -1, bestd = 1e9;
      for (let i = 0; i < p.keyframes.length; i++) {
        const k = p.keyframes[i];
        const cx = _tlT2X(k.t || 0);
        const d = Math.abs(x - cx) + Math.abs(y - cy);
        if (d <= _TL_DIAM + 4 && d < bestd) { best = i; bestd = d; }
      }
      return best;
    }

    // ---- Ruler. SECONDS by default. The fps grid is a pure
    //      RELABEL: when _tlFps>0 the tick step + label switch to
    //      frame units (label = round(t*fps)) but the stored kf.t
    //      stays SECONDS -- toggling fps NEVER mutates any t.
    function _tlNiceStep(minPxPer) {
      // Smallest "nice" seconds step whose on-screen spacing >=
      // minPxPer px (1,2,5 x 10^n).
      const raw = minPxPer / _tlZoom;
      const pow = Math.pow(10, Math.floor(Math.log10(raw <= 0 ? 1 : raw)));
      const cand = [1, 2, 5, 10];
      for (const c of cand) {
        if (pow * c >= raw) return pow * c;
      }
      return pow * 10;
    }
    function _tlDraw() {
      if (!_tlCtx) return;
      const ctx = _tlCtx;
      ctx.setTransform(_tlDpr, 0, 0, _tlDpr, 0, 0);
      ctx.clearRect(0, 0, _tlW, _tlHpx);
      const p = _tlActivePath();
      const dur = _tlDuration(p);

      // Ruler band background.
      ctx.fillStyle = 'rgba(255,255,255,0.04)';
      ctx.fillRect(0, 0, _tlW, _TL_RULER_H);

      // Tick + label step. fps grid only changes the LABEL/step
      // unit; positions are still computed from SECONDS via _tlT2X.
      const stepS = _tlNiceStep(56);
      const t0 = Math.max(0, Math.floor(_tlScroll / stepS) * stepS);
      const tEnd = _tlScroll + _tlW / _tlZoom;
      ctx.strokeStyle = 'rgba(255,255,255,0.16)';
      ctx.fillStyle = '#9aa';
      ctx.lineWidth = 1;
      ctx.font = '10px monospace';
      ctx.textBaseline = 'top';
      for (let t = t0; t <= tEnd + stepS; t += stepS) {
        const x = _tlT2X(t);
        if (x < -40 || x > _tlW + 40) continue;
        ctx.beginPath();
        ctx.moveTo(x + 0.5, 0);
        ctx.lineTo(x + 0.5, _TL_RULER_H);
        ctx.stroke();
        let lbl;
        if (_tlFps > 0) {
          // RELABEL ONLY: frame index = round(seconds * fps). The
          // stored t is unchanged; this is a display transform.
          lbl = 'f' + Math.round(t * _tlFps);
        } else {
          lbl = (Math.round(t * 1000) / 1000) + 's';
        }
        ctx.fillText(lbl, x + 3, 2);
      }

      // Selection marquee (box-select in progress). Bounded to the
      // diamond band (above the module lane bands) so a marquee never
      // paints over the cuts/other lanes below.
      if (_tlDragMode === 'box') {
        const bx = Math.min(_tlBoxX0, _tlBoxX1);
        const bw = Math.abs(_tlBoxX1 - _tlBoxX0);
        const diamBandBot = _tlLaneBandTop();
        ctx.fillStyle = 'rgba(53,224,255,0.14)';
        ctx.strokeStyle = 'rgba(53,224,255,0.6)';
        ctx.fillRect(bx, _TL_RULER_H, bw, diamBandBot - _TL_RULER_H);
        ctx.strokeRect(bx + 0.5, _TL_RULER_H + 0.5,
          bw, diamBandBot - _TL_RULER_H - 1);
      }

      // UX-Phase11-R2 #11: render the registered module lanes (Cuts +
      // any future lane) in their own horizontal bands BELOW the
      // diamond row. Drawn BEFORE the no-path early-return so a scene
      // with clips but no active camera-path still shows its cuts lane.
      _tlDrawLanes(ctx, _tlPlayheadT());

      if (!p || !p.keyframes || !p.keyframes.length) return;
      const cy = _tlDiamRowY();

      // Selection-span EDGE handles (only when 2+ selected): two
      // vertical grips at the min/max selected kf.t. Dragging one
      // scales the selected span about the OTHER (the opposite
      // anchor) -- proportional rescale.
      if (_tlSel.size >= 2) {
        let lo = Infinity, hi = -Infinity;
        _tlSel.forEach((i) => {
          const k = p.keyframes[i]; if (!k) return;
          const t = k.t || 0;
          if (t < lo) lo = t; if (t > hi) hi = t;
        });
        if (isFinite(lo) && isFinite(hi)) {
          const xL = _tlT2X(lo), xR = _tlT2X(hi);
          ctx.strokeStyle = 'rgba(53,224,255,0.5)';
          ctx.setLineDash([3, 3]);
          ctx.beginPath();
          ctx.moveTo(xL + 0.5, _TL_RULER_H);
          ctx.lineTo(xL + 0.5, _tlHpx);
          ctx.moveTo(xR + 0.5, _TL_RULER_H);
          ctx.lineTo(xR + 0.5, _tlHpx);
          ctx.stroke();
          ctx.setLineDash([]);
          ctx.fillStyle = '#35e0ff';
          ctx.fillRect(xL - 3, cy + _TL_DIAM + 3, 6, 8);
          ctx.fillRect(xR - 3, cy + _TL_DIAM + 3, 6, 8);
        }
      }

      // Diamonds (one per keyframe at its kf.t). Selected = cyan;
      // resting = orange (matches the Task-16 trajectory accent).
      for (let i = 0; i < p.keyframes.length; i++) {
        const k = p.keyframes[i];
        const cx = _tlT2X(k.t || 0);
        if (cx < -20 || cx > _tlW + 20) continue;
        const on = _tlSel.has(i);
        ctx.beginPath();
        ctx.moveTo(cx, cy - _TL_DIAM);
        ctx.lineTo(cx + _TL_DIAM, cy);
        ctx.lineTo(cx, cy + _TL_DIAM);
        ctx.lineTo(cx - _TL_DIAM, cy);
        ctx.closePath();
        ctx.fillStyle = on ? '#35e0ff' : '#ff8a3d';
        ctx.fill();
        ctx.strokeStyle = 'rgba(0,0,0,0.6)';
        ctx.lineWidth = 1;
        ctx.stroke();
      }
      void dur;
    }

    // ---- UX-Phase11-R2 #11: module-lane band rendering. The diamond
    //      band occupies the BASE lane-canvas height (_TL_H_BASE -
    //      _TL_BAR_H = ruler + diamond row); module lanes stack below
    //      it, each in a band of (lane.rows * _TL_LANE_ROW_H) px with a
    //      left gutter (_LABEL_W) carrying the lane's label and the
    //      lane's own render() filling the rest of the width. The lane
    //      render signature is the spec §4.10 contract the modules
    //      implement: render(ctx, x, y, w, h, playhead).
    function _tlLaneBandTop() {
      // Canvas-y where the first module lane band starts (the bottom of
      // the fixed ruler+diamond band).
      return _TL_H_BASE - _TL_BAR_H;
    }
    function _tlDrawLanes(ctx, playheadT) {
      if (!ctx) return;
      let lanes;
      try { lanes = _tlLaneList(); } catch (e) { return; }
      if (!lanes || !lanes.length) return;
      const laneW = Math.max(1, _tlW - _LABEL_W);
      let y = _tlLaneBandTop();
      for (const e of lanes) {
        const lane = e && e.lane;
        if (!lane) continue;
        const rows = (lane.rows && lane.rows > 0) ? (lane.rows | 0) : 1;
        const bandH = rows * _TL_LANE_ROW_H;
        // Separator line above the band.
        ctx.strokeStyle = 'rgba(255,255,255,0.10)';
        ctx.lineWidth = 1;
        ctx.beginPath();
        ctx.moveTo(0, y + 0.5);
        ctx.lineTo(_tlW, y + 0.5);
        ctx.stroke();
        // Left-gutter label cell (its own faint background + the lane
        // name, vertically centred, clipped to the gutter width).
        ctx.fillStyle = 'rgba(255,255,255,0.05)';
        ctx.fillRect(0, y, _LABEL_W, bandH);
        ctx.fillStyle = '#9aa';
        ctx.font = '9px monospace';
        ctx.textBaseline = 'middle';
        ctx.save();
        ctx.beginPath();
        ctx.rect(0, y, _LABEL_W - 2, bandH);
        ctx.clip();
        ctx.fillText(lane.label || e.name || '', 3, y + bandH / 2);
        ctx.restore();
        // The lane's own render fills the area to the right of the
        // gutter. Fault-tolerant: a throwing/absent render must not
        // break the diamond row or the playhead overlay.
        if (typeof lane.render === 'function') {
          try {
            lane.render(ctx, _LABEL_W, y, laneW, bandH, playheadT);
          } catch (err) {}
        }
        y += bandH;
      }
    }

    // ---- Playhead position (px) from the live player clock if a
    //      path is driving the camera, else the #path-scrub slider.
    //      EXACT same source the Task-16 overlay highlight uses --
    //      single source of truth, no parallel clock.
    function _tlPlayheadT() {
      const p = _tlActivePath();
      const dur = _tlDuration(p);
      if (dur <= 0) return 0;
      if (_player && _activePathId &&
          _trajBuiltPathId && _activePathId === _trajBuiltPathId) {
        const sp = _player.playSpeed || 1.0;
        let tn = ((performance.now() - _t0) / 1000) * sp;
        if (_player.loop && tn > _player.duration)
          tn = tn % _player.duration;
        return Math.max(0, Math.min(tn, dur));
      }
      if (scrubEl) {
        const f = (parseFloat(scrubEl.value) || 0) / 1000;
        return Math.max(0, Math.min(1, f)) * dur;
      }
      return 0;
    }
    function _tlSyncPlayhead() {
      const t = _tlPlayheadT();
      const x = _tlT2X(t);
      _tlPlayhead.style.left = x + 'px';
      _tlPlayhead.style.display =
        (x >= -2 && x <= _tlW + 2) ? 'block' : 'none';
      // UX-Phase11A Issue 5: keep the Play/Pause glyph in sync with the
      // live play state every time the playhead syncs (incl. the
      // per-frame timeline update() tick + a tour reaching its natural
      // end -> _player goes null -> icon flips back to ▶). Defined
      // below _tlSyncPlayPauseIcon? -> hoisted function declaration, so
      // forward-reference is safe.
      if (typeof _tlSyncPlayPauseIcon === 'function') _tlSyncPlayPauseIcon();
      // UX-Phase11G WF-H3: keep the Undo/Redo buttons' enabled state in sync
      // with the EditHistory cursor every frame (a programmatic edit, a hotkey
      // undo, or a drawer gesture all move the cursor without touching these
      // buttons directly).
      if (typeof _tlSyncUndoRedo === 'function') _tlSyncUndoRedo();
    }

    // UX-Phase11G WF-H3: Undo/Redo enabled state mirrors the registry's
    // canUndo()/canRedo(). A disabled button is dimmed + non-interactive
    // (pointer-events:none) so it reads as unavailable. Guard the registry
    // lookups -- the surface may not exist on a non-author boot / early frame.
    function _tlSyncUndoRedo() {
      let cu = false, cr = false;
      try {
        if (typeof EditorModuleRegistry !== 'undefined') {
          if (typeof EditorModuleRegistry.canUndo === 'function') {
            cu = !!EditorModuleRegistry.canUndo();
          }
          if (typeof EditorModuleRegistry.canRedo === 'function') {
            cr = !!EditorModuleRegistry.canRedo();
          }
        }
      } catch (e) {}
      _tlApplyBtnEnabled(_tlUndo, cu);
      _tlApplyBtnEnabled(_tlRedo, cr);
    }
    function _tlApplyBtnEnabled(btn, on) {
      if (!btn) return;
      btn.disabled = !on;
      btn.style.opacity = on ? '1' : '0.35';
      btn.style.pointerEvents = on ? 'auto' : 'none';
      btn.style.cursor = on ? 'pointer' : 'default';
    }

    // ---- Phase 2C (#122 §3.7): effectiveScrubRange JS mirror of the
    //      Python core/path_io.effective_scrub_range helper. When
    //      `path.total_duration_s` is a positive number it wins;
    //      otherwise derive from the largest kf.t with a 10.0s floor.
    //      Used by the total-time input + auto toggle + Prev/Next
    //      buttons -- the existing scrub/playhead math still goes
    //      through _tlDuration (player-clock-aware accumulating hold_s);
    //      this helper is the AUTHOR-FACING declarative range that
    //      decouples ceiling from last-kf time.
    function _effectiveScrubRange(p) {
      if (!p) return [0.0, 10.0];
      const total = p.total_duration_s;
      if (total !== null && total !== undefined && +total > 0) {
        return [0.0, +total];
      }
      const kfs = p.keyframes || [];
      let last = 0.0;
      for (const k of kfs) {
        const t = +(k.t || 0);
        if (t > last) last = t;
      }
      return [0.0, Math.max(last, 10.0)];
    }
    // UX-Phase11-R2 #5 (2026-05-21): the auto/manual concept is GONE
    // from the UI. The Length field is a single always-editable input;
    // refreshing it just mirrors the current effective ceiling (which
    // is total_duration_s when set, else the kf-derived max(last, 10)).
    function _tlRefreshTotalUI() {
      const p = _tlActivePath();
      const [, hi] = _effectiveScrubRange(p);
      _tlTotalInput.value = (Math.round(hi * 100) / 100).toString();
    }
    // UX-Phase11-R2 #4 (2026-05-21): auto-fit the px mapping so the full
    // 0..length range maps to the lane width. Recomputes _tlZoom from
    // the effective scrub-range ceiling + resets the left-edge scroll
    // to 0, then redraws so the diamonds reflow to fit. Called on a
    // Length commit AND on initial path load / path-select so the
    // default view always frames the whole path. Wheel-zoom still
    // overrides afterwards (this only fits on a length/path change, not
    // every frame). Guards a not-yet-measured lane (_tlW may be 0
    // before the first _tlResize) + a degenerate range.
    function _tlFitToPath() {
      const p = _tlActivePath();
      const [, hi] = _effectiveScrubRange(p);
      const usable = _tlW - 2 * _TL_PAD;
      if (usable > 1 && isFinite(hi) && hi > 1e-6) {
        let nz = usable / hi;
        if (nz < _TL_ZOOM_MIN) nz = _TL_ZOOM_MIN;
        if (nz > _TL_ZOOM_MAX) nz = _TL_ZOOM_MAX;
        _tlZoom = nz;
      }
      _tlScroll = 0;
      _tlDraw();
      _tlSyncPlayhead();
    }
    function _tlSortedKfTimes(p) {
      if (!p || !p.keyframes) return [];
      const out = [];
      for (const k of p.keyframes) {
        const t = +(k.t || 0);
        if (isFinite(t)) out.push(t);
      }
      out.sort((a, b) => a - b);
      return out;
    }
    function _tlSkipPrev() {
      const p = _tlActivePath();
      if (!p) return;
      const cur = _tlPlayheadT();
      const sorted = _tlSortedKfTimes(p);
      // Strictly LESS THAN current. Walk back from the end.
      let target = 0.0;
      for (let i = sorted.length - 1; i >= 0; i--) {
        if (sorted[i] < cur - 1e-4) { target = sorted[i]; break; }
      }
      _tlScrubToTime(Math.max(0, target));
    }
    function _tlSkipNext() {
      const p = _tlActivePath();
      if (!p) return;
      const cur = _tlPlayheadT();
      const sorted = _tlSortedKfTimes(p);
      // Strictly GREATER THAN current. Walk forward from the start.
      let target = null;
      for (const t of sorted) {
        if (t > cur + 1e-4) { target = t; break; }
      }
      if (target === null) {
        // No kf after current -> jump to scrub-range ceiling.
        const [, hi] = _effectiveScrubRange(p);
        target = hi;
      }
      _tlScrubToTime(Math.max(0, target));
    }
    function _tlPushHistorySnap(label) {
      try {
        if (typeof EditorModuleRegistry !== 'undefined' &&
            typeof EditorModuleRegistry.pushUndo === 'function') {
          EditorModuleRegistry.pushUndo(label || 'tl-edit');
        }
      } catch (e) {}
    }

    // ---- The SINGLE source of truth for live scrub: set the
    //      EXISTING #path-scrub slider value (0..1000 of the active
    //      path duration) and dispatch its REAL 'input' event so the
    //      production handler runs -- it takes `_player` over for the
    //      selected path AND rebases `_t0`, EXACTLY like a user
    //      grabbing the slider. This is what makes the live scrub
    //      robust to the author-mode default-path AUTO-TOUR (which
    //      auto-plays here): the real scrub deterministically takes
    //      the camera over from the auto-advancing tour, same as for
    //      a real user. We never reimplement the scrub math.
    function _tlScrubToTime(t) {
      const p = _tlActivePath();
      const dur = _tlDuration(p);
      if (!scrubEl || dur <= 0) return;
      // Make sure the scrub handler binds to the path the timeline
      // is editing (it reads selEl.value when _player is null).
      if (p && p.id && selEl && selEl.value !== p.id &&
          !_player) {
        try { selEl.value = p.id; } catch (e) {}
      }
      const f = Math.max(0, Math.min(1, t / dur));
      scrubEl.value = String(f * 1000);
      try {
        scrubEl.dispatchEvent(new Event('input', { bubbles: true }));
      } catch (e) {}
      _tlSyncPlayhead();
    }

    // ---- In-memory temporal edit + spline rebuild. Mutates the
    //      active path object in place (the SAME object the player +
    //      Task-16 overlay read), then rebuilds the spline. The
    //      Task-16 overlay's OverlayScene.update() sig check
    //      (_trajKfSig includes (k.t||0)) rebuilds its geometry on
    //      the next tick automatically; we ALSO null _player (if it
    //      is driving THIS path) so the live player re-derives the
    //      new geometry on its next grab. NO persistence -- this is
    //      the full Task-17 mutation scope.
    function _tlAfterEdit() {
      const p = _tlActivePath();
      if (!p) return;
      // Clamp every kf.t to be finite + >= 0 (a temporal edit must
      // never produce a NaN/negative time the spline chokes on).
      if (p.keyframes) {
        for (const k of p.keyframes) {
          let t = +k.t;
          if (!isFinite(t)) t = 0;
          if (t < 0) t = 0;
          k.t = t;
        }
      }
      // Rebuild the spline off the mutated keyframes (reuse
      // buildPlayer -- the single spline implementation). If this
      // path is the one currently driving the camera, refresh
      // _player in place + rebase _t0 to hold the current playhead
      // so the edit does not teleport the camera.
      if (_player && _activePathId === (p.id || _activePathId) &&
          _trajBuiltPathId === (p.id || null)) {
        const held = (function () {
          const sp = _player.playSpeed || 1.0;
          let tn = ((performance.now() - _t0) / 1000) * sp;
          if (_player.loop && tn > _player.duration)
            tn = tn % _player.duration;
          return tn;
        })();
        const np = buildPlayer(p);
        if (np) {
          _player = np;
          // UX-3 (2026-05-20): keep the paused-scrub identity
          // discriminator alive across an in-place player rebuild.
          // Without this the next _trajLayer.update() rebase tick
          // sees _pausedAtPlayer !== _player (stale reference to the
          // pre-edit player), the rebase becomes a no-op, and a kf
          // edit while the user was scrub-paused would silently
          // resume playback. Clamp _pausedAt to the new duration too
          // (the edit may have shortened the path).
          if (_pausedAt !== null) {
            _pausedAtPlayer = np;
            _pausedAt = Math.max(0, Math.min(_pausedAt, np.duration || 0));
          }
          const sp = np.playSpeed || 1.0;
          const ht = Math.max(0, Math.min(held, np.duration));
          _t0 = performance.now() - (ht / sp) * 1000;
        } else {
          // < 2 keyframes after a delete -> stop cleanly (reuse
          // the existing stop path, never a new mechanism).
          try { stopPath(); } catch (e) {}
        }
      }
      // Force the Task-16 overlay + this timeline to re-read NOW
      // (its layer also rebuilds on the next OverlayScene tick via
      // the sig check; this just makes the harness deterministic).
      try {
        if (window.__editor && typeof window.__editor.rebuild ===
            'function') window.__editor.rebuild();
      } catch (e) {}
      _tlDraw();
      _tlSyncPlayhead();
      // Phase 2C: keep the total-time input mirrored against
      // last-kf-changes when auto is on.
      _tlRefreshTotalUI();
    }

    // ---- Pointer interaction on the lane. One pointerdown router:
    //      a diamond hit => temporal drag; an edge-handle hit (2+
    //      selected) => span scale; the ruler band => live scrub;
    //      empty lane => box-select marquee. pointermove/up are on
    //      window so a drag that leaves the strip still tracks.
    function _tlLaneXY(ev) {
      const r = _tlLane.getBoundingClientRect();
      return { x: ev.clientX - r.left, y: ev.clientY - r.top };
    }
    function _tlHitEdge(x, y) {
      // Returns 'left'|'right'|'' for the selection-span edge grips
      // (only when 2+ selected; the grip is the small rect below
      // the diamond row at the min/max selected kf.t).
      const p = _tlActivePath();
      if (!p || _tlSel.size < 2) return '';
      let lo = Infinity, hi = -Infinity, kLo = -1, kHi = -1;
      _tlSel.forEach((i) => {
        const k = p.keyframes[i]; if (!k) return;
        const t = k.t || 0;
        if (t < lo) { lo = t; kLo = i; }
        if (t > hi) { hi = t; kHi = i; }
      });
      if (kLo < 0 || kHi < 0 || lo === hi) return '';
      const cy = _tlDiamRowY();
      if (y < cy + _TL_DIAM + 1 || y > cy + _TL_DIAM + 13) return '';
      if (Math.abs(x - _tlT2X(lo)) <= 6) return 'left';
      if (Math.abs(x - _tlT2X(hi)) <= 6) return 'right';
      return '';
    }
    function _tlOnDown(ev) {
      if (ev.button !== undefined && ev.button !== 0) return;
      const xy = _tlLaneXY(ev);
      _tlLane.setPointerCapture && (() => {
        try { _tlLane.setPointerCapture(ev.pointerId); } catch (e) {}
      })();
      ev.preventDefault();
      // (1) selection-span edge handle -> proportional scale.
      const edge = _tlHitEdge(xy.x, xy.y);
      if (edge) {
        // UX-Phase11-R2 #3 (2026-05-21): scale-edge DRAG mutates every
        // selected kf.t in _tlOnMove('scale') but pushed NO EditHistory
        // snapshot, so a rescale could not be undone. Snapshot the pre-
        // gesture cfg HERE on pointerdown (ONCE, before any pointermove
        // mutation) -- never per-move (that yields 60 entries/s).
        _tlPushHistorySnap('kf-scale');
        const p = _tlActivePath();
        let lo = Infinity, hi = -Infinity;
        _tlSel.forEach((i) => {
          const k = p.keyframes[i]; if (!k) return;
          const t = k.t || 0;
          if (t < lo) lo = t; if (t > hi) hi = t;
        });
        _tlDragMode = 'scale';
        _tlScaleEdge = edge;
        // The OPPOSITE edge time is the FIXED anchor the rescale
        // pivots about (drag 'right' -> anchor = lo; drag 'left' ->
        // anchor = hi). t' = anchor + (t-anchor)*ratio.
        _tlScaleAnchor = (edge === 'right') ? lo : hi;
        _tlScaleBase = [];
        _tlSel.forEach((i) => {
          const k = p.keyframes[i];
          if (k) _tlScaleBase.push({ i: i, t0: (k.t || 0) });
        });
        return;
      }
      // (2) diamond -> temporal drag of THAT keyframe.
      const ki = _tlHitKf(xy.x, xy.y);
      if (ki >= 0) {
        // UX-Phase11-R2 #3 (2026-05-21): a diamond time-drag mutates
        // keyframes[idx].t in _tlOnMove('kf') but pushed NO EditHistory
        // snapshot, so dragging a keyframe to a new time could not be
        // undone + the undo button greyed out wrongly. Snapshot the pre-
        // gesture cfg HERE on pointerdown (ONCE, before any pointermove
        // mutation) -- never per-move.
        _tlPushHistorySnap('kf-timeline-drag');
        _tlDragMode = 'kf';
        _tlDragKf = ki;
        // Click selects just this kf unless shift-extends; a
        // pre-existing multi-selection that includes ki is kept so
        // a drag can move the whole selection if desired (here a
        // single-kf temporal edit -- the spec's "drag a diamond
        // horizontally -> its t changes").
        if (!ev.shiftKey) {
          if (!_tlSel.has(ki)) { _tlSel.clear(); _tlSel.add(ki); }
        } else {
          if (_tlSel.has(ki)) _tlSel.delete(ki); else _tlSel.add(ki);
        }
        _tlDraw();
        return;
      }
      // (3) ruler band -> live scrub (drag the playhead). Routes
      //     through the REAL #path-scrub mechanism.
      if (xy.y <= _TL_RULER_H + 6) {
        _tlDragMode = 'play';
        _tlScrubbing = true;
        _tlScrubToTime(Math.max(0, _tlX2T(xy.x)));
        return;
      }
      // (4) empty lane -> box-select marquee.
      _tlDragMode = 'box';
      _tlBoxX0 = xy.x; _tlBoxX1 = xy.x;
      if (!ev.shiftKey) _tlSel.clear();
      _tlDraw();
    }
    function _tlOnMove(ev) {
      if (!_tlDragMode) return;
      const xy = _tlLaneXY(ev);
      if (_tlDragMode === 'kf') {
        const p = _tlActivePath();
        if (!p || !p.keyframes || _tlDragKf < 0) return;
        const k = p.keyframes[_tlDragKf];
        if (!k) return;
        let nt = _tlX2T(xy.x);
        if (!isFinite(nt)) return;
        if (nt < 0) nt = 0;
        k.t = nt;                       // the temporal edit
        _tlAfterEdit();
        return;
      }
      if (_tlDragMode === 'scale') {
        const p = _tlActivePath();
        if (!p || !_tlScaleBase) return;
        const a = _tlScaleAnchor;
        // Base span (grabbed edge - anchor) -> new span (cursor -
        // anchor). ratio = newSpan/oldSpan; proportional rescale of
        // EVERY selected kf about the fixed opposite anchor.
        let base0 = 0;
        for (const e of _tlScaleBase) {
          const d = Math.abs(e.t0 - a);
          if (d > base0) base0 = d;
        }
        if (base0 <= 1e-6) return;
        let cur = Math.abs(_tlX2T(xy.x) - a);
        // Keep the span strictly positive (do not let an edge cross
        // the anchor / collapse to zero).
        if (cur < 1e-4) cur = 1e-4;
        const ratio = cur / base0;
        for (const e of _tlScaleBase) {
          const k = p.keyframes[e.i];
          if (!k) continue;
          let nt = a + (e.t0 - a) * ratio;
          if (nt < 0) nt = 0;
          k.t = nt;
        }
        _tlAfterEdit();
        return;
      }
      if (_tlDragMode === 'play') {
        _tlScrubToTime(Math.max(0, _tlX2T(xy.x)));
        return;
      }
      if (_tlDragMode === 'box') {
        _tlBoxX1 = xy.x;
        // Live marquee selection: every keyframe whose diamond x is
        // inside the box (a fresh set unless shift-additive at down).
        const p = _tlActivePath();
        if (p && p.keyframes) {
          const lo = Math.min(_tlBoxX0, _tlBoxX1);
          const hi = Math.max(_tlBoxX0, _tlBoxX1);
          for (let i = 0; i < p.keyframes.length; i++) {
            const cx = _tlT2X(p.keyframes[i].t || 0);
            if (cx >= lo && cx <= hi) _tlSel.add(i);
          }
        }
        _tlDraw();
        return;
      }
    }
    function _tlOnUp() {
      if (_tlDragMode === 'box') {
        // Marquee finished; keep whatever fell inside it.
      }
      // UX-3 (2026-05-20): no longer stopPath() on scrub release. The
      // A6 stopPath() call here (the previous fix) set _player=null
      // which RE-ENABLED OrbitControls; the very next tick() ran
      // `if (!_player) controls.update();` which clobbered the camera
      // from the STALE pre-scrub spherical -- the "jumps back to
      // Perspective" symptom B. The scrub input handler now sets
      // _pausedAt + _pausedAtPlayer; the _trajLayer.update() per-
      // frame rebase above re-pins _t0 so the tick() player block
      // samples ~_pausedAt every frame and the camera holds at the
      // released pose. _player stays alive so `if (!_player)
      // controls.update()` is gated off -- no clobber. To exit pause:
      // press Play (startPath resumes from _pausedAt), Stop, or
      // Perspective in the camera dropdown (both stopPath).
      _tlDragMode = '';
      _tlDragKf = -1;
      _tlScrubbing = false;
      _tlScaleBase = null;
      _tlDraw();
    }
    _tlLane.addEventListener('pointerdown', _tlOnDown);
    window.addEventListener('pointermove', _tlOnMove);
    window.addEventListener('pointerup', _tlOnUp);

    // ---- Wheel zoom (time scale) about the cursor time. Storage
    //      stays SECONDS -- only the px mapping (zoom/scroll)
    //      changes; no stored t is touched.
    _tlLane.addEventListener('wheel', (ev) => {
      ev.preventDefault();
      const xy = _tlLaneXY(ev);
      const tAt = _tlX2T(xy.x);            // time under the cursor
      const f = Math.exp(-ev.deltaY * 0.0016);
      const nz = Math.max(_TL_ZOOM_MIN,
        Math.min(_TL_ZOOM_MAX, _tlZoom * f));
      _tlZoom = nz;
      // Keep the time under the cursor pinned (zoom about cursor).
      _tlScroll = tAt - (xy.x - _TL_PAD) / _tlZoom;
      if (_tlScroll < 0) _tlScroll = 0;
      _tlDraw();
      _tlSyncPlayhead();
    }, { passive: false });

    // ---- Transport (UX-Phase11A Issue 5): unified Play/Pause toggle.
    //      _tlPlay drives window.__spTransport.playPauseToggle (the
    //      tri-state idle->playing->paused machine the 10_camera_select
    //      fragment owns). Loop toggles the active path's loop flag +
    //      rebuilds (in-memory, no persistence). The icon + title sync
    //      via _tlSyncPlayPauseIcon() (called from _tlSyncPlayhead so
    //      the glyph follows the live play state every frame, incl. a
    //      tour reaching its natural end -> back to ▶).
    function _tlSyncPlayPauseIcon() {
      let st = 'idle';
      try {
        if (window.__spTransport &&
            typeof window.__spTransport.playState === 'function') {
          st = window.__spTransport.playState();
        }
      } catch (e) {}
      // playing -> ⏸ (click pauses); idle/paused -> ▶ (click plays/resumes).
      const playing = (st === 'playing');
      _tlPlay.textContent = playing ? '⏸' : '▶';
      _tlPlay.title = playing ? 'Pause' :
        (st === 'paused' ? 'Resume' : 'Play');
    }
    _tlPlay.addEventListener('click', () => {
      // Bind the timeline's active path into selEl first so the toggle
      // drives the path the user is editing (mirrors the old play
      // handler's selEl bind).
      const p = _tlActivePath();
      if (p && p.id && selEl) {
        try { selEl.value = p.id; } catch (e) {}
      }
      try {
        if (window.__spTransport &&
            typeof window.__spTransport.playPauseToggle === 'function') {
          window.__spTransport.playPauseToggle();
        } else {
          // Defensive fallback (transport surface absent): old behaviour.
          startPath(selEl ? selEl.value : (p && p.id));
        }
      } catch (e) {}
      _tlSyncPlayPauseIcon();
      _tlSyncPlayhead();
    });
    // UX-Phase11G WF-H3: Undo / Redo click -> the ONE registry coordinator.
    _tlUndo.addEventListener('click', () => {
      try {
        if (typeof EditorModuleRegistry !== 'undefined' &&
            typeof EditorModuleRegistry.undo === 'function') {
          EditorModuleRegistry.undo();
        }
      } catch (e) {}
      _tlSyncUndoRedo();
    });
    _tlRedo.addEventListener('click', () => {
      try {
        if (typeof EditorModuleRegistry !== 'undefined' &&
            typeof EditorModuleRegistry.redo === 'function') {
          EditorModuleRegistry.redo();
        }
      } catch (e) {}
      _tlSyncUndoRedo();
    });
    // Immediate enabled-state sync (don't wait for the first frame) + react
    // to every history mutation so the buttons flip the instant an edit /
    // undo / redo lands (the per-frame _tlSyncPlayhead path is the backstop).
    try {
      if (typeof EditorModuleRegistry !== 'undefined' &&
          typeof EditorModuleRegistry.on === 'function') {
        EditorModuleRegistry.on('history:push', _tlSyncUndoRedo);
        EditorModuleRegistry.on('history:undo', _tlSyncUndoRedo);
        EditorModuleRegistry.on('history:redo', _tlSyncUndoRedo);
      }
    } catch (e) {}
    _tlSyncUndoRedo();
    _tlLoop.addEventListener('click', () => {
      const p = _tlActivePath();
      if (!p) return;
      p.loop = !p.loop;
      _tlLoop.style.background = p.loop
        ? 'rgba(53,224,255,0.32)' : 'rgba(255,255,255,0.10)';
      _tlAfterEdit();
    });
    _tlFpsBtn.addEventListener('click', () => {
      // Cycle OFF -> 24 -> 30 -> 60 -> OFF. PURE RELABEL of the
      // ruler -- it NEVER mutates a stored kf.t (the storage unit
      // is always seconds; this only changes tick labels).
      const cyc = [0, 24, 30, 60];
      const idx = cyc.indexOf(_tlFps);
      _tlFps = cyc[(idx + 1) % cyc.length];
      _tlFpsBtn.textContent = _tlFps > 0 ? (_tlFps + 'fps') : 'fps';
      _tlFpsBtn.style.background = _tlFps > 0
        ? 'rgba(53,224,255,0.32)' : 'rgba(255,255,255,0.10)';
      _tlDraw();                 // relabel only; NO _tlAfterEdit()
    });

    // ---- Phase 2C handlers: Prev/Next-keyframe skip + the Length
    //      input commit. Prev/Next are NAVIGATION (no EditHistory
    //      snapshot). The Length commit is an EDIT (one snapshot, on
    //      commit -- never per keystroke).
    //  UX-Phase11-R2 #5 (2026-05-21): no more auto/manual gate -- the
    //      field is always editable. A commit writes the parsed value
    //      to `total_duration_s` (positive only; a non-positive /
    //      empty entry reverts to the last value rather than clearing
    //      to null, so the field never falls back into "auto"). ONE
    //      EditHistory snapshot on commit, labelled 'path-length'.
    //  UX-Phase11-R2 #4 (2026-05-21): after writing the new length the
    //      timeline auto-fits (_tlFitToPath recomputes _tlZoom so the
    //      full 0..length range fills the lane width + resets scroll)
    //      so the diamonds reflow to the new range instead of staying
    //      pinned at the old pixel positions.
    _tlPrevKf.addEventListener('click', () => { _tlSkipPrev(); });
    _tlNextKf.addEventListener('click', () => { _tlSkipNext(); });
    function _tlCommitTotalInput() {
      const p = _tlActivePath();
      if (!p) return;
      const v = parseFloat(_tlTotalInput.value);
      const prev = (p.total_duration_s !== undefined &&
        p.total_duration_s !== null) ? +p.total_duration_s : null;
      // A non-positive / non-finite entry is rejected -> revert the
      // field to the current effective ceiling (no null write, so the
      // length never silently reverts to the kf-derived auto value).
      if (!(isFinite(v) && v > 0)) { _tlRefreshTotalUI(); return; }
      if (v === prev) { _tlRefreshTotalUI(); return; }
      _tlPushHistorySnap('path-length');
      p.total_duration_s = v;
      _tlRefreshTotalUI();
      _tlFitToPath();
    }
    _tlTotalInput.addEventListener('change', _tlCommitTotalInput);
    _tlTotalInput.addEventListener('keydown', (ev) => {
      if (ev.key === 'Enter') {
        ev.preventDefault();
        try { _tlTotalInput.blur(); } catch (e) {}
        _tlCommitTotalInput();
      }
    });

    // ---- Phase 2C hotkeys: Ctrl+Left / Ctrl+Right -> Prev/Next-kf
    //      skip. Same author-mode gate + text-input skip pattern the
    //      17a Ctrl+Z/Y handler uses. NO EditHistory snapshot
    //      (navigation, not edit -- the playhead position is not part
    //      of the persisted cfg).
    window.addEventListener('keydown', (ev) => {
      if (!ModeManager.is('author')) return;
      const mod = ev.metaKey || ev.ctrlKey;
      if (!mod) return;
      // UX-Phase11F H6: shared guard (04_js_prologue) -- supersets the
      // prior INPUT/TEXTAREA/SELECT + contenteditable check AND adds
      // [role=menu]/[role=dialog] so Ctrl+Arrow does not skip keyframes
      // with the kebab menu / a Save dialog focused.
      if (_editorHotkeyBlocked()) return;
      if (ev.key === 'ArrowLeft') {
        ev.preventDefault();
        _tlSkipPrev();
      } else if (ev.key === 'ArrowRight') {
        ev.preventDefault();
        _tlSkipNext();
      }
    });

    // ---- X deletes the selected keyframes (in-memory mutation +
    //      spline rebuild; refuse to drop below 2 so the path stays
    //      a valid spline -- a sensible clamp, not a hidden mode).
    window.addEventListener('keydown', (ev) => {
      if (!ModeManager.is('author')) return;
      if (ev.key !== 'x' && ev.key !== 'X' &&
          ev.key !== 'Delete') return;
      // UX-Phase11F H6: shared guard (04_js_prologue) -- supersets the
      // prior INPUT/TEXTAREA/SELECT check AND adds contenteditable +
      // [role=menu]/[role=dialog]. Critical here: X DELETES the selected
      // keyframe(s); without the menu/dialog guard, Tab-ing to the kebab
      // menu (or a Save dialog) and pressing X silently dropped a keyframe.
      if (_editorHotkeyBlocked()) return;
      if (!_tlSel.size) return;
      const p = _tlActivePath();
      if (!p || !p.keyframes) return;
      const keep = [];
      for (let i = 0; i < p.keyframes.length; i++) {
        if (!_tlSel.has(i)) keep.push(p.keyframes[i]);
      }
      if (keep.length < 2) {
        // Clamp: a path needs >= 2 keyframes to be a spline; ignore
        // a delete that would invalidate it (do NOT silently break
        // the path).
        return;
      }
      // UX-Phase11-R2 #3 (2026-05-21): keyframe DELETE was NOT pushing an
      // EditHistory snapshot, so a delete could not be undone + the undo
      // button greyed out wrongly. Snapshot the pre-mutation cfg BEFORE the
      // reassign (gesture-start; a single X/Delete press, once per gesture).
      // Pushed only past the >=2 clamp so a no-op delete leaves no entry.
      _tlPushHistorySnap('kf-delete');
      p.keyframes = keep;
      _tlSel.clear();
      _tlAfterEdit();
    });

    // The strip + diamonds + playhead must follow window resize and
    // the splat canvas size (it is absolutely positioned over it).
    window.addEventListener('resize', _tlResize);
    // Initial layout once the strip has a measured size (next frame
    // so getBoundingClientRect is non-zero), then keep the playhead
    // synced from the ONE OverlayScene tick (no parallel rAF: we
    // fan a tiny per-frame playhead sync off the SAME tick the
    // Task-16 overlay already uses -- see the layer below).
    //  UX-Phase11-R2 #4: fit the px mapping to the active path on the
    //      first measured layout so the default view frames the whole
    //      0..length range (not a fixed 80 px/s window). _tlResize runs
    //      first so _tlW is non-zero before _tlFitToPath reads it.
    requestAnimationFrame(() => {
      _tlResize();
      _tlRefreshTotalUI();
      _tlFitToPath();
    });

    // ---- Phase 2D (#122 §4.10): multi-lane bottom-timeline registry.
    //      A module advertises a timeline-lane intent
    //      (timelineLane = { rows, label, render(ctx, x, y, w, h, t) })
    //      via EditorModuleRegistry. The registry exposes:
    //        timelineLanes.register(module)  -- pulls module.timelineLane
    //        timelineLanes.list()            -- ordered Lane[]
    //        timelineLanes.unregister(name)  -- removes by module name
    //      and CameraPathModule is auto-registered via the
    //      EditorModuleRegistry's 'register' event.
    //
    //      UX-Phase11-R2 #11 (2026-05-21): the VISUAL integration that
    //      Phase 2D deferred ("lands in Phases 3-7" -- it never did) is
    //      now wired. _tlDraw (above) calls _tlDrawLanes() which
    //      iterates this registry + calls each lane's render() in its
    //      own horizontal band below the diamond row, and the strip
    //      grows (_tlSyncHeight) by sum(lane.rows) * _TL_LANE_ROW_H so
    //      the bands are visible. Registering / unregistering a lane
    //      re-syncs the height + redraws so a late-registered module
    //      (the 15x modules register synchronously before this IIFE,
    //      but a runtime register still grows the strip) appears
    //      immediately. The diamond row + playhead overlay are
    //      untouched -- the lanes stack strictly below them.
    const _tlLanesByName = Object.create(null);
    const _tlLanesOrder = [];
    const _LABEL_W = 36;            // left-gutter label width (px)
    function _tlLaneRegister(mod) {
      if (!mod || !mod.name || !mod.timelineLane) return false;
      if (Object.prototype.hasOwnProperty.call(_tlLanesByName, mod.name)) {
        return false;
      }
      const lane = mod.timelineLane;
      _tlLanesByName[mod.name] = lane;
      _tlLanesOrder.push(mod.name);
      // Grow the strip for the new band + redraw (no-op before the
      // first _tlResize measures _tlW; the rAF layout re-syncs anyway).
      _tlSyncHeight();
      _tlDraw();
      return true;
    }
    function _tlLaneUnregister(name) {
      if (!Object.prototype.hasOwnProperty.call(_tlLanesByName, name)) {
        return false;
      }
      delete _tlLanesByName[name];
      const i = _tlLanesOrder.indexOf(name);
      if (i !== -1) _tlLanesOrder.splice(i, 1);
      _tlSyncHeight();
      _tlDraw();
      return true;
    }
    function _tlLaneList() {
      return _tlLanesOrder.map((n) => ({
        name: n, lane: _tlLanesByName[n],
      }));
    }
    // Subscribe to module registrations. The CameraPathModule
    // registers itself BEFORE this IIFE runs (15a < 16 in fragment
    // order); the 'register' event listener pulls it on first
    // attach, and the catch-up walk handles modules that already
    // registered. Later phase modules trigger on register.
    try {
      EditorModuleRegistry.on('register', _tlLaneRegister);
      const _alreadyRegistered = EditorModuleRegistry.list();
      for (const m of _alreadyRegistered) _tlLaneRegister(m);
    } catch (e) {}

    // Fan the per-frame playhead sync off the ONE OverlayScene
    // tick (Task-0 contract -- no parallel rAF). modes:['author']
    // so OverlayScene skips update() outside author mode (inert in
    // user/embed). node-less (it is pure DOM, not a 3D node) so
    // OverlayScene never touches a node's visibility for it.
    const _tlLayer = {
      id: 'editor-timeline',
      modes: ['author'],
      update() {
        if (!ModeManager.is('author')) return;
        if (!_tlScrubbing) _tlSyncPlayhead();
      },
    };
    OverlayScene.register(_tlLayer);

    // ---- TEST-ONLY surface extension (mirror window.__clip /
    //      __transport / the Task-16 window.__editor: getters +
    //      deterministic hooks; NO production reader; inert without
    //      the harness). Extends the EXISTING window.__editor object
    //      (created by the Task-16 block above) so the harness reads
    //      one surface. Every hook drives the REAL code path a user
    //      action would (the same convention as __editor.scrubTo /
    //      __clip.restart).
    try {
      if (window.__editor) {
        const _api = {
          // ---- read state ----
          get tlPresent() { return !!_tlStrip.parentNode; },
          get tlZoom() { return _tlZoom; },
          get tlScroll() { return _tlScroll; },
          get tlFps() { return _tlFps; },
          get tlDuration() { return _tlDuration(_tlActivePath()); },
          get tlSelection() {
            return Array.from(_tlSel).sort((a, b) => a - b);
          },
          // The stored keyframe times (SECONDS) of the active path,
          // in keyframe-array order (NOT sorted) so the harness can
          // assert a SPECIFIC kf's t changed / is byte-identical.
          get tlKfTimes() {
            const p = _tlActivePath();
            return (p && p.keyframes)
              ? p.keyframes.map(k => (k.t || 0)) : [];
          },
          // Diamond screen positions (px) + their kf.t, so the
          // harness can assert px == time->px under zoom/scroll.
          get tlDiamonds() {
            const p = _tlActivePath();
            if (!p || !p.keyframes) return [];
            return p.keyframes.map((k, i) => ({
              i: i, t: (k.t || 0), x: _tlT2X(k.t || 0),
              sel: _tlSel.has(i),
            }));
          },
          // Playhead time (seconds) + px -- the harness asserts a
          // playhead drag moves the CAMERA (read _spDebug.camera).
          get tlPlayheadT() { return _tlPlayheadT(); },
          get tlPlayheadX() {
            return parseFloat(_tlPlayhead.style.left) || 0;
          },
          get tlActivePathId() {
            const p = _tlActivePath();
            return p ? (p.id || null) : null;
          },
          get tlLoop() {
            const p = _tlActivePath();
            return !!(p && p.loop);
          },
          // ---- deterministic hooks (drive the REAL handlers) ----
          // Live scrub: routes through the REAL #path-scrub input
          // mechanism (single source of truth -- takes _player over
          // + rebases _t0, robust to the auto-tour). frac in 0..1.
          tlScrub(frac) {
            const dur = _tlDuration(_tlActivePath());
            _tlScrubToTime(Math.max(0, Math.min(1, +frac || 0)) * dur);
            return _tlPlayheadT();
          },
          // Temporal edit: set keyframe[idx].t = newT (the SAME
          // mutation a diamond drag performs) + rebuild.
          tlDragKf(idx, newT) {
            const p = _tlActivePath();
            if (!p || !p.keyframes || !p.keyframes[idx]) return false;
            let t = +newT;
            if (!isFinite(t)) return false;
            if (t < 0) t = 0;
            // UX-Phase11-R2 #3 (2026-05-21): mirror the pointerdown diamond-
            // drag snapshot so a programmatic/harness time-drag is undoable
            // too (one snapshot at the gesture start, before the mutation).
            _tlPushHistorySnap('kf-timeline-drag');
            p.keyframes[idx].t = t;
            _tlAfterEdit();
            return true;
          },
          // Selection set (by kf index) -- the SAME state a marquee
          // produces; lets the harness deterministically select 2+.
          tlSelect(idxs) {
            _tlSel.clear();
            (idxs || []).forEach((i) => {
              if (i >= 0) _tlSel.add(i | 0);
            });
            _tlDraw();
            return Array.from(_tlSel).sort((a, b) => a - b);
          },
          // Box-select by a time window [t0,t1] (drives the SAME
          // marquee selection math the pointer path uses).
          tlBoxSelect(t0, t1) {
            const p = _tlActivePath();
            _tlSel.clear();
            if (p && p.keyframes) {
              const lo = Math.min(+t0, +t1), hi = Math.max(+t0, +t1);
              for (let i = 0; i < p.keyframes.length; i++) {
                const t = p.keyframes[i].t || 0;
                if (t >= lo && t <= hi) _tlSel.add(i);
              }
            }
            _tlDraw();
            return Array.from(_tlSel).sort((a, b) => a - b);
          },
          // Scale the selected span by dragging an EDGE: move the
          // grabbed edge ('left'|'right') to newEdgeT; the opposite
          // edge is the fixed anchor; proportional rescale (the
          // SAME math _tlOnMove('scale') runs). Returns the post-
          // scale stored times of the selected kfs.
          tlScaleSelection(edge, newEdgeT) {
            const p = _tlActivePath();
            if (!p || !p.keyframes || _tlSel.size < 2) return null;
            let lo = Infinity, hi = -Infinity;
            _tlSel.forEach((i) => {
              const k = p.keyframes[i]; if (!k) return;
              const t = k.t || 0;
              if (t < lo) lo = t; if (t > hi) hi = t;
            });
            if (!isFinite(lo) || !isFinite(hi) || lo === hi)
              return null;
            // UX-Phase11-R2 #3 (2026-05-21): mirror the pointerdown scale-
            // edge snapshot so a programmatic/harness rescale is undoable
            // too (one snapshot at the gesture start, before the mutation).
            _tlPushHistorySnap('kf-scale');
            const anchor = (edge === 'right') ? lo : hi;
            let base0 = Math.abs(((edge === 'right') ? hi : lo) -
              anchor);
            if (base0 <= 1e-6) return null;
            let cur = Math.abs((+newEdgeT) - anchor);
            if (cur < 1e-4) cur = 1e-4;
            const ratio = cur / base0;
            const base = [];
            _tlSel.forEach((i) => {
              base.push({ i: i, t0: (p.keyframes[i].t || 0) });
            });
            for (const e of base) {
              let nt = anchor + (e.t0 - anchor) * ratio;
              if (nt < 0) nt = 0;
              p.keyframes[e.i].t = nt;
            }
            _tlAfterEdit();
            return { anchor: anchor, ratio: ratio,
              times: Array.from(_tlSel).sort((a, b) => a - b)
                .map(i => (p.keyframes[i].t || 0)) };
          },
          // X delete the current selection (the SAME mutation the
          // keydown handler performs; honours the >=2 clamp).
          tlDeleteSelection() {
            const p = _tlActivePath();
            if (!p || !p.keyframes || !_tlSel.size) return false;
            const keep = [];
            for (let i = 0; i < p.keyframes.length; i++) {
              if (!_tlSel.has(i)) keep.push(p.keyframes[i]);
            }
            if (keep.length < 2) return false;
            // UX-Phase11-R2 #3 (2026-05-21): mirror the keydown X-handler's
            // pre-mutation snapshot so the harness/test-surface delete is
            // undoable too (once per gesture, past the >=2 clamp).
            _tlPushHistorySnap('kf-delete');
            p.keyframes = keep;
            _tlSel.clear();
            _tlAfterEdit();
            return true;
          },
          // Transport (drive the REAL #path-play/#path-stop reuse).
          tlPlay() {
            const p = _tlActivePath();
            if (p && p.id && selEl) {
              try { selEl.value = p.id; } catch (e) {}
            }
            try { startPath(selEl ? selEl.value : (p && p.id)); }
            catch (e) {}
            return !!_player;
          },
          tlPause() {
            try { stopPath(); } catch (e) {}
            _tlSyncPlayhead();
            return !_player;
          },
          // UX-Phase11A Issue 5: the unified Play/Pause toggle test
          // hooks. tlPlayPauseToggle drives the REAL _tlPlay click
          // path (selEl bind + window.__spTransport.playPauseToggle +
          // icon sync); tlPlayState reads the tri-state; tlPlayIcon
          // reads the current glyph so the harness can assert the
          // ▶/⏸ swap end-to-end.
          tlPlayPauseToggle() {
            try { _tlPlay.click(); } catch (e) {}
            return (window.__spTransport &&
                    typeof window.__spTransport.playState === 'function')
              ? window.__spTransport.playState() : 'idle';
          },
          tlPlayState() {
            return (window.__spTransport &&
                    typeof window.__spTransport.playState === 'function')
              ? window.__spTransport.playState() : 'idle';
          },
          tlPlayIcon() { return _tlPlay.textContent; },
          tlToggleLoop() {
            const p = _tlActivePath();
            if (!p) return null;
            p.loop = !p.loop;
            _tlAfterEdit();
            return !!p.loop;
          },
          // Wheel zoom about a time (the SAME zoom math the wheel
          // handler runs); factor>1 zooms IN. Storage stays seconds.
          tlZoomAbout(tAt, factor) {
            const xAt = _tlT2X(+tAt);
            _tlZoom = Math.max(_TL_ZOOM_MIN,
              Math.min(_TL_ZOOM_MAX, _tlZoom * (+factor || 1)));
            _tlScroll = (+tAt) - (xAt - _TL_PAD) / _tlZoom;
            if (_tlScroll < 0) _tlScroll = 0;
            _tlDraw();
            _tlSyncPlayhead();
            return _tlZoom;
          },
          // fps grid toggle (RELABEL ONLY -- asserts stored t
          // unchanged before/after). Pass a specific fps or cycle.
          tlSetFps(v) {
            _tlFps = (v && v > 0) ? (v | 0) : 0;
            _tlFpsBtn.textContent =
              _tlFps > 0 ? (_tlFps + 'fps') : 'fps';
            _tlDraw();
            return _tlFps;
          },
          // The Task-16 trajectory overlay's current keyframe
          // signature -- so the harness can assert an in-memory
          // temporal edit actually triggered the overlay rebuild
          // (the sig CHANGED) without a save/network.
          get tlOverlaySig() {
            try {
              const p = _tlActivePath();
              return (typeof _trajKfSig === 'function')
                ? _trajKfSig(p) : '';
            } catch (e) { return ''; }
          },
          // v2-C Phase 2 follow-on (R2): force a timeline redraw
          // against the current _tlActivePath(). Used by _camSelApply
          // when the author rebinds to a different camera so the
          // bottom-timeline diamonds reflect the NEW path immediately
          // (the timeline IIFE's per-frame update() only syncs the
          // playhead position; it never redraws the diamond row off
          // path-change alone). _tlDraw + _tlSyncPlayhead are the SAME
          // pair every existing edit-hook (_tlAfterEdit / tlZoomAbout
          // / tlSetFps) uses, so this reuses the canonical refresh.
          // Safe for a freshly-created empty-keyframes path:
          // _tlDraw's `if (!p || !p.keyframes || !p.keyframes.length)
          // return;` short-circuits AFTER clearing the canvas, so the
          // strip ends up genuinely EMPTY rather than showing stale
          // diamonds from the prior camera.
          tlRedraw() {
            // Phase 2C: the active path may have changed; refresh
            // the Length field off the new path's
            // total_duration_s / kf-derived ceiling.
            _tlRefreshTotalUI();
            // UX-Phase11-R2 #4: a path-select rebinds the timeline to a
            // DIFFERENT path -- fit the px mapping to the new path's
            // range so its diamonds frame the lane (instead of keeping
            // the previous path's zoom/scroll). _tlFitToPath calls
            // _tlDraw + _tlSyncPlayhead, so this still does the same
            // refresh pair the prior body did.
            _tlFitToPath();
          },
          // ---- Phase 2C test surface ----
          // The Python-mirror helper (tests assert against it).
          get tlEffectiveScrubRange() {
            return _effectiveScrubRange(_tlActivePath());
          },
          // Drive the REAL handler the click runs (so the harness can
          // assert the snapshot + cfg mutation without simulating a
          // pointer event).
          tlSkipPrev() { _tlSkipPrev(); return _tlPlayheadT(); },
          tlSkipNext() { _tlSkipNext(); return _tlPlayheadT(); },
          // Phase 2D multi-lane registry test surface.
          get tlLaneCount() { return _tlLanesOrder.length; },
          get tlLaneNames() { return _tlLanesOrder.slice(); },
          get tlLabelGutterPx() { return _LABEL_W; },
          // UX-Phase11-R2 #5: the always-on Length field's px-per-second
          // zoom + scroll, so the harness can assert the #4 auto-fit
          // reflow (diamonds move) after a length commit.
          get tlZoomNow() { return _tlZoom; },
          // Set the Length value (the SAME path Enter/blur in the input
          // runs: one snapshot labelled 'path-length' + an auto-fit).
          // Returns the post-commit value. A non-positive / non-finite
          // value is rejected (no null write -- the field never reverts
          // to "auto"); the prior value is returned.
          tlSetTotalDuration(v) {
            const p = _tlActivePath();
            if (!p) return null;
            const prev = (p.total_duration_s !== undefined &&
              p.total_duration_s !== null) ? +p.total_duration_s : null;
            if (!(isFinite(+v) && +v > 0)) return prev;
            if (+v === prev) return prev;
            _tlPushHistorySnap('path-length');
            p.total_duration_s = +v;
            _tlRefreshTotalUI();
            _tlFitToPath();
            return p.total_duration_s;
          },
        };
        // Copy onto the Task-16 window.__editor PRESERVING getters as
        // GETTERS (Object.assign would invoke each getter once and
        // freeze the RESULT as a static data property -- so a later
        // tlZoomAbout/tlSetFps/tlDragKf mutation would not be visible
        // through window.__editor.tlZoom/.tlFps/.tlKfTimes). Copy the
        // property DESCRIPTORS so the getters stay live (mirrors how
        // the Task-16 surface itself uses real getters).
        Object.defineProperties(
          window.__editor, Object.getOwnPropertyDescriptors(_api));
      }
    } catch (e) {}
  })();

