      const i = _tlLanesOrder.indexOf(name);
      if (i !== -1) _tlLanesOrder.splice(i, 1);
      _tlSyncHeight();
      _tlDraw();
      return true;
    }
    function _tlLaneList() {
      return _tlLanesOrder.map((n) => ({
        name: n, lane: _tlLanesByName[n],
