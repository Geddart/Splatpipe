            // drag snapshot so a programmatic/harness time-drag is undoable
            // too (one snapshot at the gesture start, before the mutation).
            _tlPushHistorySnap('kf-timeline-drag');
            p.keyframes[idx].t = t;
            _tlAfterEdit();
            return true;
          },
          // Selection set (by kf index) -- the SAME state a marquee
          // produces; lets the harness deterministically select 2+.
          tlSelect(idxs) {
